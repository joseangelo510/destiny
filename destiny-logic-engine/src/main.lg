# Destiny Logic Engine

Deterministic rules for turning a completed SEO audit into the next clear
customer action. This is intentionally small: LOGOS validates business rules;
the customer-facing Destiny application, accounts, integrations, and hosting
live in the web platform.

## To native args () -> Seq of Text

## To native parseInt (value: Text) -> Int

## To ChooseDecisionCode (audit_complete: Int) and (critical_issues: Int) and (warnings: Int) and (new_keywords: Int) and (lost_keywords: Int) and (content_gaps: Int) and (review_count: Int) -> Text:

    If audit_complete equals 0:
        Return "audit_waiting".
    If critical_issues is greater than 0:
        Return "fix_technical".
    If lost_keywords is greater than new_keywords:
        Return "refresh_declining".
    If content_gaps is greater than 0:
        Return "publish_gap".
    If review_count is less than 10:
        Return "request_reviews".
    If warnings is greater than 0:
        Return "fix_warning".
    Return "distribute_expertise".

## To ChooseGrowthStage (audit_complete: Int) and (critical_issues: Int) and (ranking_keywords: Int) and (new_keywords: Int) and (lost_keywords: Int) and (content_gaps: Int) -> Text:

    If audit_complete equals 0:
        Return "audit_in_progress".
    If critical_issues is greater than 0:
        Return "fix_foundations".
    If ranking_keywords is less than 10:
        Return "build_search_coverage".
    If lost_keywords is greater than new_keywords:
        Return "build_search_coverage".
    If content_gaps is greater than 0:
        Return "build_search_coverage".
    Return "compound_distribution".

## To ChooseWeeklyQuest (decision_code: Text) -> Text:

    If decision_code equals "audit_waiting":
        Return "Wait for the website audit to finish".
    If decision_code equals "fix_technical":
        Return "Fix the highest-impact technical issue".
    If decision_code equals "refresh_declining":
        Return "Refresh the page losing the most search visibility".
    If decision_code equals "publish_gap":
        Return "Publish the highest-opportunity page".
    If decision_code equals "request_reviews":
        Return "Ask three recent customers for a Google review".
    If decision_code equals "fix_warning":
        Return "Resolve the highest-impact on-page warning".
    Return "Answer one relevant question on Reddit or Quora".

## To ChooseQuestCategory (decision_code: Text) -> Text:

    If decision_code equals "audit_waiting":
        Return "measurement".
    If decision_code equals "fix_technical":
        Return "technical".
    If decision_code equals "fix_warning":
        Return "technical".
    If decision_code equals "refresh_declining":
        Return "content".
    If decision_code equals "publish_gap":
        Return "content".
    If decision_code equals "request_reviews":
        Return "reviews".
    Return "distribution".

## To ChooseUrgency (decision_code: Text) and (critical_issues: Int) -> Text:

    If decision_code equals "audit_waiting":
        Return "waiting".
    If critical_issues is greater than 2:
        Return "urgent".
    If decision_code equals "fix_technical":
        Return "high".
    If decision_code equals "refresh_declining":
        Return "high".
    If decision_code equals "publish_gap":
        Return "focused".
    If decision_code equals "request_reviews":
        Return "focused".
    Return "routine".

## To ChooseExplanation (decision_code: Text) -> Text:

    If decision_code equals "audit_waiting":
        Return "Destiny is collecting live search and website evidence before choosing your first task".
    If decision_code equals "fix_technical":
        Return "Critical technical issues can block crawling ranking and conversions so the highest-impact issue comes first".
    If decision_code equals "refresh_declining":
        Return "More keywords were lost than gained so refreshing the page with the largest decline is the clearest recovery move".
    If decision_code equals "publish_gap":
        Return "The audit found unanswered search demand so publishing the strongest content gap is the best next growth move".
    If decision_code equals "request_reviews":
        Return "The review base is still small so recent customer proof is the strongest local trust and conversion opportunity".
    If decision_code equals "fix_warning":
        Return "No critical blocker remains but an on-page warning is the clearest low-risk improvement to complete next".
    Return "The foundation is healthy so distributing expertise on a relevant community question can compound visibility".

## To ChooseKeywordVerdict (core_matches: Int) and (support_matches: Int) and (competitor_rankers: Int) and (blocklisted: Int) -> Text:

    If blocklisted is greater than 0:
        Return "reject".
    If core_matches is greater than 0:
        Return "accept".
    If support_matches is greater than 1:
        If competitor_rankers is greater than 0:
            Return "review".
    Return "reject".

## To ChooseKeywordRule (core_matches: Int) and (support_matches: Int) and (competitor_rankers: Int) and (blocklisted: Int) -> Text:

    If blocklisted is greater than 0:
        Return "blocked_noise".
    If core_matches is greater than 0:
        If competitor_rankers is greater than 1:
            Return "essential_gap".
        Return "site_vocabulary_match".
    If support_matches is greater than 0:
        If competitor_rankers is greater than 0:
            Return "borderline_gap".
        Return "supporting_evidence".
    Return "no_vocabulary_match".

## To ChooseKeywordReason (keyword_rule: Text) -> Text:

    If keyword_rule equals "blocked_noise":
        Return "The phrase matches a blocked navigational or low-intent pattern".
    If keyword_rule equals "essential_gap":
        Return "The phrase matches the site's core vocabulary and at least two competitors rank for it".
    If keyword_rule equals "site_vocabulary_match":
        Return "The phrase is directly supported by the site's core vocabulary".
    If keyword_rule equals "borderline_gap":
        Return "The phrase has supporting site evidence and competitor demand but needs human review".
    If keyword_rule equals "supporting_evidence":
        Return "The phrase has supporting business evidence and remains a secondary opportunity for review".
    Return "The phrase is not supported by enough inspectable site evidence".

## To ChooseEssentialKeyword (keyword_rule: Text) -> Text:

    If keyword_rule equals "essential_gap":
        Return "true".
    Return "false".

## To ChooseWeeklyTaskCount (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "8".
    If plan_tier equals 2:
        Return "5".
    Return "3".

## To ChooseContentTaskCount (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "3".
    If plan_tier equals 2:
        Return "2".
    Return "1".

## To ChooseDistributionTaskCount (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "4".
    If plan_tier equals 2:
        Return "2".
    Return "0".

## To ChooseWeeklyTaskManifest (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "keyword_review,primary_quest,content_review,community_distribution,social_distribution,publisher_outreach,directory_growth,technical_review".
    If plan_tier equals 2:
        Return "keyword_review,primary_quest,content_review,community_distribution,social_distribution".
    Return "keyword_review,primary_quest,content_review".

## To ChooseWeeklyTaskApprovals (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "true,false,true,false,false,true,false,false".
    If plan_tier equals 2:
        Return "true,false,true,false,false".
    Return "true,false,true".

## To ChooseWeeklyTaskTiers (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "1,1,1,2,2,3,3,3".
    If plan_tier equals 2:
        Return "1,1,1,2,2".
    Return "1,1,1".

## To ChooseWeeklyTaskPriorities (plan_tier: Int) -> Text:

    If plan_tier is greater than 2:
        Return "1,1,1,2,2,3,3,3".
    If plan_tier equals 2:
        Return "1,1,1,2,2".
    Return "1,1,1".

## To ChooseIssueQuestCode (critical_render_blocking: Int) and (critical_high_loading: Int) and (critical_no_title: Int) and (critical_no_description: Int) and (critical_no_h1: Int) and (critical_no_alt: Int) and (warning_render_blocking: Int) and (warning_high_loading: Int) and (warning_no_title: Int) and (warning_no_description: Int) and (warning_no_h1: Int) and (warning_no_alt: Int) -> Text:

    If critical_render_blocking is greater than 0:
        Return "has_render_blocking_resources".
    If critical_high_loading is greater than 0:
        Return "high_loading_time".
    If critical_no_title is greater than 0:
        Return "no_title".
    If critical_no_description is greater than 0:
        Return "no_description".
    If critical_no_h1 is greater than 0:
        Return "no_h1_tag".
    If critical_no_alt is greater than 0:
        Return "no_image_alt".
    If warning_render_blocking is greater than 0:
        Return "has_render_blocking_resources".
    If warning_high_loading is greater than 0:
        Return "high_loading_time".
    If warning_no_title is greater than 0:
        Return "no_title".
    If warning_no_description is greater than 0:
        Return "no_description".
    If warning_no_h1 is greater than 0:
        Return "no_h1_tag".
    If warning_no_alt is greater than 0:
        Return "no_image_alt".
    Return "none".

## To ChooseQuestSource (issue_quest_code: Text) -> Text:

    If issue_quest_code equals "none":
        Return "growth_action".
    Return "issue_fix".

## To ChooseIssueQuestCategory (issue_quest_code: Text) and (growth_category: Text) -> Text:

    If issue_quest_code equals "none":
        Return growth_category.
    Return "technical".

## To ChooseIssueQuestTitle (issue_quest_code: Text) and (growth_quest: Text) -> Text:

    If issue_quest_code equals "has_render_blocking_resources":
        Return "Make your homepage load faster for visitors".
    If issue_quest_code equals "high_loading_time":
        Return "Reduce the time visitors wait for your homepage".
    If issue_quest_code equals "no_title":
        Return "Give your homepage a clear search title".
    If issue_quest_code equals "no_description":
        Return "Add a clear search description to your homepage".
    If issue_quest_code equals "no_h1_tag":
        Return "Add one clear main heading to your homepage".
    If issue_quest_code equals "no_image_alt":
        Return "Describe important images for search and accessibility".
    Return growth_quest.

## To ChooseIssueQuestUrgency (issue_quest_code: Text) and (recognized_critical_issues: Int) and (growth_urgency: Text) -> Text:

    If issue_quest_code equals "none":
        Return growth_urgency.
    If recognized_critical_issues is greater than 0:
        Return "urgent".
    Return "focused".

## To ChooseIssueQuestExplanation (issue_quest_code: Text) and (growth_explanation: Text) -> Text:

    If issue_quest_code equals "none":
        Return growth_explanation.
    Return "Destiny selected the highest-priority inspectable website issue so the first action removes a concrete search and visitor barrier".

## To ChooseIssueDataQuality (issue_quest_code: Text) and (unknown_issue_count: Int) -> Text:

    If issue_quest_code equals "none":
        If unknown_issue_count is greater than 0:
            Return "unknown_issue".
    Return "complete".

## To ChooseKeywordRelevanceCode (core_matches: Int) and (support_matches: Int) -> Int:

    If core_matches is greater than 0:
        Return 2.
    If support_matches is greater than 0:
        Return 1.
    Return 0.

## To ChooseKeywordRelevanceTier (relevance_code: Int) -> Text:

    If relevance_code equals 2:
        Return "core".
    If relevance_code equals 1:
        Return "adjacent".
    Return "none".

## To ChooseKeywordEligibility (policy_enabled: Int) and (search_volume: Int) and (disqualifiers: Int) and (blocklisted: Int) and (relevance_code: Int) -> Text:

    If policy_enabled equals 0:
        Return "legacy".
    If search_volume is less than 1:
        Return "false".
    If disqualifiers is greater than 0:
        Return "false".
    If blocklisted is greater than 0:
        Return "false".
    If relevance_code equals 0:
        Return "false".
    Return "true".

## To ChooseKeywordSearchIntent (intent_code: Int) -> Text:

    If intent_code equals 3:
        Return "conversion".
    If intent_code equals 2:
        Return "consideration".
    If intent_code equals 1:
        Return "consideration".
    Return "awareness".

## To ChooseKeywordIntentPoints (intent_code: Int) -> Int:

    If intent_code equals 3:
        Return 25.
    If intent_code equals 2:
        Return 21.
    If intent_code equals 1:
        Return 6.
    Return 8.

## To RoundedWeight (value: Int) and (weight: Int) -> Int:

    Return ((value * weight) + 50) divided by 100.

## To ClampKeywordScore (score: Int) -> Int:

    If score is less than 0:
        Return 0.
    If score is greater than 100:
        Return 100.
    Return score.

## To ChooseVolumePoints (search_volume: Int) -> Int:

    If search_volume is greater than 18835:
        Return 10.
    If search_volume is greater than 6682:
        Return 9.
    If search_volume is greater than 2370:
        Return 8.
    If search_volume is greater than 840:
        Return 7.
    If search_volume is greater than 297:
        Return 6.
    If search_volume is greater than 104:
        Return 5.
    If search_volume is greater than 36:
        Return 4.
    If search_volume is greater than 12:
        Return 3.
    If search_volume is greater than 3:
        Return 2.
    If search_volume is greater than 0:
        Return 1.
    Return 0.

## To ChooseAttainabilityPoints (difficulty: Int) -> Int:

    If difficulty is less than 0:
        Return 5.
    If difficulty is greater than 100:
        Return 0.
    Return (((100 - difficulty) * 5) + 50) divided by 100.

## To ChooseValuePoints (cpc_cents: Int) -> Int:

    If cpc_cents is greater than 3288:
        Return 5.
    If cpc_cents is greater than 1448:
        Return 4.
    If cpc_cents is greater than 607:
        Return 3.
    If cpc_cents is greater than 223:
        Return 2.
    If cpc_cents is greater than 47:
        Return 1.
    Return 0.

## To ChooseOpportunityPoints (opportunity_code: Int) and (rank: Int) and (competitor_rankers: Int) and (direct_competitor_rankers: Int) -> Int:

    If opportunity_code equals 1:
        If rank is greater than 3:
            If rank is less than 21:
                Return 5.
        Return 4.
    If opportunity_code equals 2:
        If direct_competitor_rankers is greater than 0:
            Let direct_points be 3 + direct_competitor_rankers.
            If direct_points is greater than 5:
                Return 5.
            Return direct_points.
        Let competitor_points be 1 + ((competitor_rankers + 1) divided by 2).
        If competitor_points is greater than 3:
            Return 3.
        Return competitor_points.
    Return 2.

## To ChooseKeywordPriorityScore (policy_enabled: Int) and (eligible: Text) and (intent_code: Int) and (business_fit_percent: Int) and (revenue_fit_percent: Int) and (search_volume: Int) and (difficulty: Int) and (cpc_cents: Int) and (opportunity_code: Int) and (rank: Int) and (competitor_rankers: Int) and (direct_competitor_rankers: Int) -> Int:

    If policy_enabled equals 0:
        Return 0.
    If eligible equals "false":
        Return 0.
    Let intent_points be ChooseKeywordIntentPoints(intent_code).
    Let business_points be RoundedWeight(business_fit_percent, 30).
    Let revenue_points be RoundedWeight(revenue_fit_percent, 20).
    Let volume_points be ChooseVolumePoints(search_volume).
    Let attainability_points be ChooseAttainabilityPoints(difficulty).
    Let value_points be ChooseValuePoints(cpc_cents).
    Let opportunity_points be ChooseOpportunityPoints(opportunity_code, rank, competitor_rankers, direct_competitor_rankers).
    Let demand_penalty be 0.
    If search_volume is less than 20:
        If intent_code is less than 3:
            Set demand_penalty to 3.
    Let score be intent_points + business_points + revenue_points + volume_points + attainability_points + value_points + opportunity_points - demand_penalty.
    Return ClampKeywordScore(score).

## To ChooseKeywordPriorityTier (policy_enabled: Int) and (eligible: Text) and (relevance_code: Int) and (revenue_fit_percent: Int) -> Int:

    If policy_enabled equals 0:
        Return 0.
    If eligible equals "false":
        Return 0.
    If relevance_code equals 2:
        If revenue_fit_percent is greater than 84:
            Return 1.
        If revenue_fit_percent is greater than 44:
            Return 2.
        Return 3.
    Return 4.

## To ChooseKeywordPolicyCode (policy_enabled: Int) and (search_volume: Int) and (disqualifiers: Int) and (blocklisted: Int) and (relevance_code: Int) and (intent_code: Int) -> Text:

    If policy_enabled equals 0:
        Return "legacy_keyword_policy".
    If search_volume is less than 1:
        Return "reject_no_demand".
    If disqualifiers is greater than 0:
        Return "reject_disqualified".
    If blocklisted is greater than 0:
        Return "reject_blocklisted".
    If relevance_code equals 0:
        Return "reject_no_relevance".
    If relevance_code equals 2:
        If intent_code equals 3:
            Return "eligible_core_conversion".
        If intent_code equals 2:
            Return "eligible_core_consideration".
        Return "eligible_core_awareness".
    If intent_code equals 3:
        Return "eligible_adjacent_conversion".
    If intent_code equals 2:
        Return "eligible_adjacent_consideration".
    Return "eligible_adjacent_awareness".

## To ChooseKeywordEssential (eligible: Text) and (relevance_code: Int) and (revenue_fit_percent: Int) and (intent_code: Int) and (direct_competitor_rankers: Int) -> Text:

    If eligible equals "false":
        Return "false".
    If relevance_code is less than 2:
        Return "false".
    If revenue_fit_percent is less than 65:
        Return "false".
    If direct_competitor_rankers is greater than 0:
        Return "true".
    If intent_code equals 3:
        Return "true".
    Return "false".

## To ChooseKeywordDataQuality (intent_known: Int) -> Text:

    If intent_known equals 0:
        Return "intent_missing".
    Return "complete".

## To ChooseKeywordRuleIds (policy_code: Text) and (keyword_rule: Text) -> Text:

    If policy_code equals "reject_no_demand":
        Return "reject_no_demand".
    If policy_code equals "reject_disqualified":
        Return "reject_disqualified".
    If policy_code equals "reject_blocklisted":
        Return "reject_blocklisted,blocked_noise".
    If policy_code equals "reject_no_relevance":
        Return "reject_no_relevance,no_vocabulary_match".
    If keyword_rule equals "essential_gap":
        Return "essential_gap".
    If keyword_rule equals "site_vocabulary_match":
        Return "site_vocabulary_match".
    If keyword_rule equals "borderline_gap":
        Return "borderline_gap".
    If keyword_rule equals "supporting_evidence":
        Return "supporting_evidence".
    Return policy_code.

## To ChooseAuthoritativeKeywordVerdict (policy_enabled: Int) and (eligible: Text) and (relevance_code: Int) and (legacy_verdict: Text) -> Text:

    If policy_enabled equals 0:
        Return legacy_verdict.
    If eligible equals "false":
        Return "reject".
    If relevance_code equals 2:
        Return "accept".
    Return "review".

## Main

    Let arguments be args().
    Let audit_complete be parseInt(item 2 of arguments).
    Let critical_issues be parseInt(item 3 of arguments).
    Let warnings be parseInt(item 4 of arguments).
    Let ranking_keywords be parseInt(item 5 of arguments).
    Let new_keywords be parseInt(item 6 of arguments).
    Let lost_keywords be parseInt(item 7 of arguments).
    Let content_gaps be parseInt(item 8 of arguments).
    Let review_count be parseInt(item 9 of arguments).
    Let keyword_core_matches be parseInt(item 10 of arguments).
    Let keyword_support_matches be parseInt(item 11 of arguments).
    Let competitor_rankers be parseInt(item 12 of arguments).
    Let keyword_blocklisted be parseInt(item 13 of arguments).
    Let plan_tier be parseInt(item 14 of arguments).
    Let keyword_policy_enabled be parseInt(item 15 of arguments).
    Let keyword_positive_demand be parseInt(item 16 of arguments).
    Let keyword_disqualifiers be parseInt(item 17 of arguments).
    Let keyword_intent_code be parseInt(item 18 of arguments).
    Let keyword_relevance_code be parseInt(item 19 of arguments).
    Let keyword_business_fit_percent be parseInt(item 20 of arguments).
    Let keyword_revenue_fit_percent be parseInt(item 21 of arguments).
    Let keyword_volume_points be parseInt(item 22 of arguments).
    Let keyword_attainability_points be parseInt(item 23 of arguments).
    Let keyword_value_points be parseInt(item 24 of arguments).
    Let keyword_opportunity_points be parseInt(item 25 of arguments).
    Let keyword_demand_penalty be parseInt(item 26 of arguments).
    Let keyword_search_volume be parseInt(item 27 of arguments).
    Let keyword_difficulty be parseInt(item 28 of arguments).
    Let keyword_cpc_cents be parseInt(item 29 of arguments).
    Let keyword_rank be parseInt(item 30 of arguments).
    Let keyword_opportunity_code be parseInt(item 31 of arguments).
    Let direct_competitor_rankers be parseInt(item 32 of arguments).
    Let keyword_intent_known be parseInt(item 33 of arguments).
    Let critical_render_blocking be parseInt(item 34 of arguments).
    Let critical_high_loading be parseInt(item 35 of arguments).
    Let critical_no_title be parseInt(item 36 of arguments).
    Let critical_no_description be parseInt(item 37 of arguments).
    Let critical_no_h1 be parseInt(item 38 of arguments).
    Let critical_no_alt be parseInt(item 39 of arguments).
    Let warning_render_blocking be parseInt(item 40 of arguments).
    Let warning_high_loading be parseInt(item 41 of arguments).
    Let warning_no_title be parseInt(item 42 of arguments).
    Let warning_no_description be parseInt(item 43 of arguments).
    Let warning_no_h1 be parseInt(item 44 of arguments).
    Let warning_no_alt be parseInt(item 45 of arguments).
    Let unknown_issue_count be parseInt(item 46 of arguments).
    Let decision_code be ChooseDecisionCode(audit_complete, critical_issues, warnings, new_keywords, lost_keywords, content_gaps, review_count).
    Let growth_stage be ChooseGrowthStage(audit_complete, critical_issues, ranking_keywords, new_keywords, lost_keywords, content_gaps).
    Let growth_quest be ChooseWeeklyQuest(decision_code).
    Let issue_quest_code be ChooseIssueQuestCode(critical_render_blocking, critical_high_loading, critical_no_title, critical_no_description, critical_no_h1, critical_no_alt, warning_render_blocking, warning_high_loading, warning_no_title, warning_no_description, warning_no_h1, warning_no_alt).
    Let quest_source be ChooseQuestSource(issue_quest_code).
    Let weekly_quest be ChooseIssueQuestTitle(issue_quest_code, growth_quest).
    Let growth_category be ChooseQuestCategory(decision_code).
    Let quest_category be ChooseIssueQuestCategory(issue_quest_code, growth_category).
    Let growth_urgency be ChooseUrgency(decision_code, critical_issues).
    Let recognized_critical_issues be critical_render_blocking + critical_high_loading + critical_no_title + critical_no_description + critical_no_h1 + critical_no_alt.
    Let urgency be ChooseIssueQuestUrgency(issue_quest_code, recognized_critical_issues, growth_urgency).
    Let growth_explanation be ChooseExplanation(decision_code).
    Let explanation be ChooseIssueQuestExplanation(issue_quest_code, growth_explanation).
    Let legacy_keyword_verdict be ChooseKeywordVerdict(keyword_core_matches, keyword_support_matches, competitor_rankers, keyword_blocklisted).
    Let authoritative_relevance_code be ChooseKeywordRelevanceCode(keyword_core_matches, keyword_support_matches).
    Let keyword_eligible be ChooseKeywordEligibility(keyword_policy_enabled, keyword_search_volume, keyword_disqualifiers, keyword_blocklisted, authoritative_relevance_code).
    Let keyword_verdict be ChooseAuthoritativeKeywordVerdict(keyword_policy_enabled, keyword_eligible, authoritative_relevance_code, legacy_keyword_verdict).
    Let keyword_rule_id be ChooseKeywordRule(keyword_core_matches, keyword_support_matches, competitor_rankers, keyword_blocklisted).
    Let keyword_reason be ChooseKeywordReason(keyword_rule_id).
    Let essential_keyword be ChooseEssentialKeyword(keyword_rule_id).
    Let weekly_task_count be ChooseWeeklyTaskCount(plan_tier).
    Let content_task_count be ChooseContentTaskCount(plan_tier).
    Let distribution_task_count be ChooseDistributionTaskCount(plan_tier).
    Let weekly_task_manifest be ChooseWeeklyTaskManifest(plan_tier).
    Let weekly_task_approvals be ChooseWeeklyTaskApprovals(plan_tier).
    Let weekly_task_tiers be ChooseWeeklyTaskTiers(plan_tier).
    Let weekly_task_priorities be ChooseWeeklyTaskPriorities(plan_tier).
    Let issue_data_quality be ChooseIssueDataQuality(issue_quest_code, unknown_issue_count).
    Let keyword_search_intent be ChooseKeywordSearchIntent(keyword_intent_code).
    Let keyword_priority_tier be ChooseKeywordPriorityTier(keyword_policy_enabled, keyword_eligible, authoritative_relevance_code, keyword_revenue_fit_percent).
    Let keyword_priority_score be ChooseKeywordPriorityScore(keyword_policy_enabled, keyword_eligible, keyword_intent_code, keyword_business_fit_percent, keyword_revenue_fit_percent, keyword_search_volume, keyword_difficulty, keyword_cpc_cents, keyword_opportunity_code, keyword_rank, competitor_rankers, direct_competitor_rankers).
    Let keyword_policy_code be ChooseKeywordPolicyCode(keyword_policy_enabled, keyword_search_volume, keyword_disqualifiers, keyword_blocklisted, authoritative_relevance_code, keyword_intent_code).
    Let keyword_relevance_tier be ChooseKeywordRelevanceTier(authoritative_relevance_code).
    Let keyword_essential be ChooseKeywordEssential(keyword_eligible, authoritative_relevance_code, keyword_revenue_fit_percent, keyword_intent_code, direct_competitor_rankers).
    Let keyword_data_quality be ChooseKeywordDataQuality(keyword_intent_known).
    Let keyword_rule_ids be ChooseKeywordRuleIds(keyword_policy_code, keyword_rule_id).
    Show growth_stage.
    Show decision_code.
    Show weekly_quest.
    Show quest_category.
    Show urgency.
    Show explanation.
    Show keyword_verdict.
    Show keyword_rule_id.
    Show keyword_reason.
    Show essential_keyword.
    Show weekly_task_count.
    Show content_task_count.
    Show distribution_task_count.
    Show weekly_task_manifest.
    Show keyword_eligible.
    Show keyword_search_intent.
    Show keyword_priority_tier.
    Show keyword_priority_score.
    Show keyword_policy_code.
    Show keyword_relevance_tier.
    Show keyword_essential.
    Show keyword_data_quality.
    Show keyword_rule_ids.
    Show quest_source.
    Show issue_quest_code.
    Show issue_data_quality.
    Show weekly_task_approvals.
    Show weekly_task_tiers.
    Show weekly_task_priorities.
