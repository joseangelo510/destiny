    Let audit_visible_issues be parseInt(item (planning_start + 52) of arguments).
    Let rank_status_code be parseInt(item (planning_start + 53) of arguments).
    Let rank_found_code be parseInt(item (planning_start + 54) of arguments).
    Let rank_current_position be parseInt(item (planning_start + 55) of arguments).
    Let rank_has_previous be parseInt(item (planning_start + 56) of arguments).
    Let rank_previous_found be parseInt(item (planning_start + 57) of arguments).
    Let rank_previous_position be parseInt(item (planning_start + 58) of arguments).
    Let rank_has_last_check be parseInt(item (planning_start + 59) of arguments).
    Let rank_age_hours be parseInt(item (planning_start + 60) of arguments).
    Let rank_age_days be parseInt(item (planning_start + 61) of arguments).
    Let article_format_code be parseInt(item (planning_start + 62) of arguments).
    Let article_word_count be parseInt(item (planning_start + 63) of arguments).
    Let article_h1_count be parseInt(item (planning_start + 64) of arguments).
    Let article_h2_count be parseInt(item (planning_start + 65) of arguments).
    Let article_h3_count be parseInt(item (planning_start + 66) of arguments).
    Let article_skipped_level be parseInt(item (planning_start + 67) of arguments).
    Let article_title_keyword be parseInt(item (planning_start + 68) of arguments).
    Let article_first_h2_keyword be parseInt(item (planning_start + 69) of arguments).
    Let article_keyword_free_percent be parseInt(item (planning_start + 70) of arguments).
    Let article_brigade_count be parseInt(item (planning_start + 71) of arguments).
    Let article_first_brigade be parseInt(item (planning_start + 72) of arguments).
    Let article_min_brigade_gap be parseInt(item (planning_start + 73) of arguments).
    Let article_stock_phrase be parseInt(item (planning_start + 74) of arguments).
    Let article_meta_count be parseInt(item (planning_start + 75) of arguments).
    Let article_meta_overlength be parseInt(item (planning_start + 76) of arguments).
    Let article_source_count be parseInt(item (planning_start + 77) of arguments).
    Let article_cited_count be parseInt(item (planning_start + 78) of arguments).
    Let decision_code be ChooseDecisionCode(audit_complete, critical_issues, warnings, new_keywords, lost_keywords, content_gaps, review_count).
    Let growth_stage be ChooseGrowthStage(audit_complete, critical_issues, ranking_keywords, new_keywords, lost_keywords, content_gaps).
    Let growth_quest be ChooseWeeklyQuest(decision_code).
    Let issue_quest_code be ChooseIssueQuestCode(critical_render_blocking, critical_high_loading, critical_no_title, critical_no_description, critical_no_h1, critical_no_alt, warning_render_blocking, warning_high_loading, warning_no_title, warning_no_description, warning_no_h1, warning_no_alt).
    Let quest_source be ChooseQuestSource(issue_quest_code).
    Let weekly_quest be ChooseIssueQuestTitle(issue_quest_code, growth_quest).
    Let growth_category be ChooseQuestCategory(decision_code).
    Let quest_category be ChooseIssueQuestCategory(issue_quest_code, growth_category).
    Let growth_urgency be ChooseUrgency(decision_code, critical_issues).
    Let recognized_critical_issues be critical_render_blocking + critical_high_loading + critical_no_title + critical_no_description + critical_no_h1 + critical_no_alt.
    Let urgency be ChooseIssueQuestUrgency(issue_quest_code, recognized_critical_issues, growth_urgency).
    Let growth_explanation be ChooseExplanation(decision_code).
    Let explanation be ChooseIssueQuestExplanation(issue_quest_code, growth_explanation).
    Let legacy_keyword_verdict be ChooseKeywordVerdict(keyword_core_matches, keyword_support_matches, competitor_rankers, keyword_blocklisted).
    Let authoritative_relevance_code be ChooseKeywordRelevanceCode(keyword_core_matches, keyword_support_matches).
    Let keyword_eligible be ChooseKeywordEligibility(keyword_policy_enabled, keyword_search_volume, keyword_disqualifiers, keyword_blocklisted, authoritative_relevance_code).
    Let keyword_verdict be ChooseAuthoritativeKeywordVerdict(keyword_policy_enabled, keyword_eligible, authoritative_relevance_code, legacy_keyword_verdict).
    Let keyword_rule_id be ChooseKeywordRule(keyword_core_matches, keyword_support_matches, competitor_rankers, keyword_blocklisted).
    Let keyword_reason be ChooseKeywordReason(keyword_rule_id).
    Let essential_keyword be ChooseEssentialKeyword(keyword_rule_id).
    Let weekly_task_count be ChooseWeeklyTaskCount(plan_tier).
    Let content_task_count be ChooseContentTaskCount(plan_tier).
    Let distribution_task_count be ChooseDistributionTaskCount(plan_tier).
    Let weekly_task_manifest be ChooseWeeklyTaskManifest(plan_tier).
    Let weekly_task_approvals be ChooseWeeklyTaskApprovals(plan_tier).
    Let weekly_task_tiers be ChooseWeeklyTaskTiers(plan_tier).
    Let weekly_task_priorities be ChooseWeeklyTaskPriorities(plan_tier).
    Let issue_data_quality be ChooseIssueDataQuality(issue_quest_code, unknown_issue_count).
    Let quest_transition_allowed be ChooseQuestTransitionAllowed(quest_task_code, quest_current_status_code, quest_requested_status_code).
    Let quest_transition_rule_id be ChooseQuestTransitionRule(quest_task_code, quest_current_status_code, quest_requested_status_code).
    Let quest_verification_status be ChooseQuestVerificationStatus(quest_task_code, quest_requested_status_code).
    Let quest_set_completed_at be ChooseQuestSetCompletedAt(quest_requested_status_code).
    Let quest_set_verified_at be ChooseQuestSetVerifiedAt(quest_task_code, quest_requested_status_code).
    Let quest_clear_evidence be ChooseQuestClearEvidence(quest_requested_status_code).
    Let quest_celebration be ChooseQuestCelebration(quest_transition_allowed, quest_task_code, quest_requested_status_code, quest_remaining_after_completion, quest_verification_status).
    Let streak_current be ChooseCurrentWeeklyStreak(arguments, streak_current_week, streak_week_count).
    Let streak_best be ChooseBestWeeklyStreak(arguments, streak_week_count).
    Let streak_perfect_weeks be ChoosePerfectWeekCount(arguments, streak_week_count, streak_plan_count).
    Let keyword_search_intent be ChooseKeywordSearchIntent(keyword_intent_code).
    Let keyword_priority_tier be ChooseKeywordPriorityTier(keyword_policy_enabled, keyword_eligible, authoritative_relevance_code, keyword_revenue_fit_percent).
    Let keyword_priority_score be ChooseKeywordPriorityScore(keyword_policy_enabled, keyword_eligible, keyword_intent_code, keyword_business_fit_percent, keyword_revenue_fit_percent, keyword_search_volume, keyword_difficulty, keyword_cpc_cents, keyword_opportunity_code, keyword_rank, competitor_rankers, direct_competitor_rankers).
    Let keyword_policy_code be ChooseKeywordPolicyCode(keyword_policy_enabled, keyword_search_volume, keyword_disqualifiers, keyword_blocklisted, authoritative_relevance_code, keyword_intent_code).
    Let keyword_relevance_tier be ChooseKeywordRelevanceTier(authoritative_relevance_code).
    Let keyword_essential be ChooseKeywordEssential(keyword_eligible, authoritative_relevance_code, keyword_revenue_fit_percent, keyword_intent_code, direct_competitor_rankers).
    Let keyword_data_quality be ChooseKeywordDataQuality(keyword_intent_known).
    Let keyword_rule_ids be ChooseKeywordRuleIds(keyword_policy_code, keyword_rule_id).
    Let plan_can_export be ChoosePlanCanExport(plan_identity_matches).
    Let plan_identity_rule_id be ChoosePlanIdentityRule(plan_identity_matches).
    Let plan_keyword_target_low be ChoosePlanKeywordTargetLow(plan_approved_keywords, plan_usable_keywords).
    Let plan_keyword_target_high be ChoosePlanKeywordTargetHigh(plan_keyword_target_low, plan_usable_keywords).
    Let plan_forecast_confidence be ChoosePlanForecastConfidence(plan_data_quality_flags).
    Let editorial_intent_code be ChooseEditorialIntentCode(editorial_conversion_language, editorial_commercial_language, editorial_provider_intent_code).
    Let editorial_search_intent be ChooseKeywordSearchIntent(editorial_intent_code).
    Let editorial_business_fit be ChooseEditorialBusinessFit(editorial_business_model_code, editorial_product_query, editorial_service_query).
    Let editorial_offer_fit be ChooseEditorialOfferFit(editorial_theme_role_code, editorial_offer_overlap).
    Let editorial_priority_tier be ChooseKeywordPriorityTier(1, keyword_eligible, authoritative_relevance_code, editorial_offer_fit * 25).
    Let editorial_priority_score be ChooseKeywordPriorityScore(1, keyword_eligible, editorial_intent_code, editorial_business_fit * 50, editorial_offer_fit * 25, keyword_search_volume, keyword_difficulty, keyword_cpc_cents, keyword_opportunity_code, keyword_rank, competitor_rankers, direct_competitor_rankers).
    Let editorial_keyword_index be ChooseEditorialKeywordIndex(editorial_week_slot, editorial_keyword_count).
    Let editorial_angle_code be ChooseEditorialAngleCode(editorial_week_slot).
    Let editorial_inferred_business_model_code be ChooseEditorialBusinessModel(editorial_product_evidence, editorial_service_evidence).
    Let progress_compounding be ChooseProgressCompounding(progress_page_one, progress_clicks, progress_key_events).
    Let progress_current_node be ChooseProgressCurrentNode(progress_foundation_status, progress_content_status, progress_impressions, progress_clicks, progress_page_two, progress_page_one, progress_key_events, progress_compounding).
    Let progress_task_excluded be ChooseProgressTaskExcluded(progress_task_code).
    Let progress_task_phase be ChooseProgressTaskPhase(progress_task_code).
    Let progress_task_state be ChooseProgressTaskState(progress_task_status_code, progress_current_chosen, progress_any_in_progress).
    Let llm_content_state be ChooseLlmEffortState(llm_content_state_code).
    Let llm_platform_state be ChooseLlmEffortState(llm_platform_state_code).
    Let llm_authority_state be ChooseLlmEffortState(llm_authority_state_code).
    Let llm_outcome_state be ChooseLlmOutcomeState(llm_evidence_available, llm_mentions).
    Let llm_next_step be ChooseLlmNextStep(llm_content_state_code, llm_platform_state_code, llm_authority_state_code).
    Let source_progress_percent be ChoosePercent(source_completed, source_total).
    Let source_proof_percent be ChoosePercent(source_proof_attached, source_proof_possible).
    Let source_progress_state be ChooseSourceState(source_completed, source_total).
    Let coach_task_order be ChooseCoachTaskOrder(progress_task_code).
    Let coach_category be ChooseCoachCategory(progress_task_code, progress_task_category_code).
    Let progress_data_quality be ChooseProgressDataQuality(progress_provider_available).
    Let momentum_onboarding_current be ChooseOnboardingCurrentStage(momentum_onboarding_step).
    Let momentum_onboarding_completed be momentum_onboarding_current - 1.
    Let momentum_onboarding_percent be ((momentum_onboarding_completed * 100) + 1) divided by 3.
    Let momentum_audit_percent be ClampPercent(momentum_audit_progress).
    If momentum_audit_status_code equals 1:
        Set momentum_audit_percent to 100.
    Let momentum_audit_completed be ChooseAuditCompletedStages(momentum_audit_percent).
    Let momentum_audit_current be ChooseAuditCurrentStage(momentum_audit_completed).
    Let momentum_audit_ready be "false".
    If momentum_audit_status_code equals 1:
        If momentum_audit_percent equals 100:
            Set momentum_audit_ready to "true".
    Let momentum_timing_delayed be ChooseTimingDelayed(momentum_audit_status_code, momentum_elapsed_seconds).
    Let momentum_timing_seconds be ChooseTimingSeconds(momentum_audit_status_code, momentum_audit_percent, momentum_timing_delayed).
    Let onboarding_one_ready be ChooseRequiredStepReady(onboarding_one_fields, 5, onboarding_email_valid, onboarding_url_valid).
    Let onboarding_two_ready be ChooseSimpleStepReady(onboarding_two_fields, 3).
    Let audit_health_score be ChooseAuditHealthScore(audit_health_available, audit_health_raw).
    Let audit_health_code be ChooseAuditHealthCode(audit_health_score).
    Let audit_is_partial be ChooseAuditPartial(audit_measured_critical, audit_measured_warnings, audit_visible_issues).
    Let rank_reading_code be ChooseRankReadingCode(rank_status_code, rank_found_code, rank_current_position).
    Let rank_movement_code be ChooseRankMovementCode(rank_status_code, rank_has_previous, rank_found_code, rank_current_position, rank_previous_found, rank_previous_position).
    Let rank_movement_delta be ChooseRankMovementDelta(rank_current_position, rank_previous_position).
    Let rank_freshness_code be ChooseRankFreshnessCode(rank_has_last_check, rank_age_hours, rank_age_days).
    Let rank_bucket be ChooseRankBucket(rank_found_code, rank_current_position).
    Let article_word_issue be ChooseArticleWordIssue(article_format_code, article_word_count).
    Let article_heading_issue be ChooseArticleHeadingIssue(article_format_code, article_h1_count, article_h2_count, article_h3_count, article_skipped_level).
    Let article_heading_keyword_issue be "false".
    If article_title_keyword equals 0:
        Set article_heading_keyword_issue to "true".
    If article_first_h2_keyword equals 0:
        Set article_heading_keyword_issue to "true".
    Let article_heading_variety_issue be "false".
    If article_keyword_free_percent is less than 40:
        Set article_heading_variety_issue to "true".
    Let article_brigade_issue be ChooseArticleBrigadeIssue(article_format_code, article_brigade_count).
    Let article_brigade_spacing_issue be "false".
    If article_brigade_count is greater than 0:
        If article_first_brigade is greater than 150:
            Set article_brigade_spacing_issue to "true".
        If article_brigade_count is greater than 1:
            If article_min_brigade_gap is less than 100:
                Set article_brigade_spacing_issue to "true".
    Let article_stock_issue be "false".
    If article_stock_phrase equals 1:
        Set article_stock_issue to "true".
    Let article_meta_issue be "false".
    If article_meta_count is less than 2:
        Set article_meta_issue to "true".
    If article_meta_count is greater than 2:
        Set article_meta_issue to "true".
    If article_meta_overlength equals 1:
        Set article_meta_issue to "true".
    Let article_source_issue be ChooseArticleSourceIssue(article_format_code, article_source_count, article_cited_count).
