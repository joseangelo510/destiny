## To ChooseQuestTransitionAllowed (task_code: Int) and (current_status_code: Int) and (requested_status_code: Int) -> Text:

    If current_status_code is greater than 2:
        Return "false".
    If requested_status_code is greater than 2:
        Return "false".
    If requested_status_code equals 2:
        If task_code equals 2:
            Return "false".
        If task_code equals 3:
            Return "false".
    Return "true".

## To ChooseQuestTransitionRule (task_code: Int) and (current_status_code: Int) and (requested_status_code: Int) -> Text:

    If current_status_code is greater than 2:
        Return "reject_unknown_current_status".
    If requested_status_code is greater than 2:
        Return "reject_unknown_requested_status".
    If requested_status_code equals 2:
        If task_code equals 2:
            Return "reject_required_task_skip".
        If task_code equals 3:
            Return "reject_required_task_skip".
    If current_status_code equals requested_status_code:
        Return "allow_noop".
    If requested_status_code equals 1:
        Return "allow_complete".
    If requested_status_code equals 0:
        Return "allow_reopen".
    Return "allow_skip".

## To ChooseQuestVerificationStatus (task_code: Int) and (requested_status_code: Int) -> Text:

    If requested_status_code equals 1:
        If task_code equals 1:
            Return "verified".
    Return "unverified".

## To ChooseQuestSetCompletedAt (requested_status_code: Int) -> Text:

    If requested_status_code equals 1:
        Return "true".
    Return "false".

## To ChooseQuestSetVerifiedAt (task_code: Int) and (requested_status_code: Int) -> Text:

    If requested_status_code equals 1:
        If task_code equals 1:
            Return "true".
    Return "false".

## To ChooseQuestClearEvidence (requested_status_code: Int) -> Text:

    If requested_status_code equals 1:
        Return "false".
    Return "true".

## To ChooseQuestCelebration (transition_allowed: Text) and (task_code: Int) and (requested_status_code: Int) and (remaining_after_completion: Int) and (verification_status: Text) -> Text:

    If transition_allowed equals "false":
        Return "none".
    If requested_status_code equals 0:
        Return "none".
    If requested_status_code equals 2:
        Return "none".
    If requested_status_code is greater than 2:
        Return "none".
    If remaining_after_completion equals 0:
        Return "perfect_week".
    If verification_status equals "verified":
        Return "verified_result".
    If task_code equals 2:
        Return "roadmap_unlock".
    If task_code equals 4:
        Return "roadmap_unlock".
    Return "task_complete".

## To HasActiveWeek (arguments: Seq of Text) and (week_count: Int) and (target_week: Int) -> Int:

    If week_count equals 0:
        Return 0.
    Repeat for week_offset from 1 to week_count:
        Let argument_index be 53 + week_offset.
        Let saved_week be parseInt(item argument_index of arguments).
        If saved_week equals target_week:
            Return 1.
    Return 0.

## To ChooseCurrentWeeklyStreak (arguments: Seq of Text) and (current_week: Int) and (week_count: Int) -> Int:

    If week_count equals 0:
        Return 0.
    Let cursor be current_week.
    Let current_active be HasActiveWeek(arguments, week_count, cursor).
    If current_active equals 0:
        Set cursor to cursor - 1.
    Let streak be 0.
    Let keep_counting be HasActiveWeek(arguments, week_count, cursor).
    While keep_counting equals 1:
        Set streak to streak + 1.
        Set cursor to cursor - 1.
        Set keep_counting to HasActiveWeek(arguments, week_count, cursor).
    Return streak.

## To ChooseBestWeeklyStreak (arguments: Seq of Text) and (week_count: Int) -> Int:

    If week_count equals 0:
        Return 0.
    Let best be 0.
    Let running be 0.
    Let previous be -999999999.
    Repeat for week_offset from 1 to week_count:
        Let argument_index be 53 + week_offset.
        Let saved_week be parseInt(item argument_index of arguments).
        If saved_week equals previous + 1:
            Set running to running + 1.
        Otherwise:
            Set running to 1.
        If running is greater than best:
            Set best to running.
        Set previous to saved_week.
    Return best.

## To ChoosePerfectWeekCount (arguments: Seq of Text) and (week_count: Int) and (plan_count: Int) -> Int:

    If plan_count equals 0:
        Return 0.
    Let perfect_count be 0.
    Let plan_start be 54 + week_count.
    Repeat for plan_offset from 1 to plan_count:
        Let total_index be plan_start + ((plan_offset - 1) * 2).
        Let complete_index be total_index + 1.
        Let total_tasks be parseInt(item total_index of arguments).
        Let complete_tasks be parseInt(item complete_index of arguments).
        If total_tasks is greater than 0:
            If complete_tasks equals total_tasks:
                Set perfect_count to perfect_count + 1.
    Return perfect_count.

## To ChooseKeywordRelevanceCode (core_matches: Int) and (support_matches: Int) -> Int:

    If core_matches is greater than 0:
        Return 2.
    If support_matches is greater than 0:
        Return 1.
    Return 0.

## To ChooseKeywordRelevanceTier (relevance_code: Int) -> Text:

    If relevance_code equals 2:
        Return "core".
    If relevance_code equals 1:
        Return "adjacent".
    Return "none".

## To ChooseKeywordEligibility (policy_enabled: Int) and (search_volume: Int) and (disqualifiers: Int) and (blocklisted: Int) and (relevance_code: Int) -> Text:

    If policy_enabled equals 0:
        Return "legacy".
    If search_volume is less than 1:
        Return "false".
    If disqualifiers is greater than 0:
        Return "false".
    If blocklisted is greater than 0:
        Return "false".
    If relevance_code equals 0:
        Return "false".
    Return "true".

## To ChooseKeywordSearchIntent (intent_code: Int) -> Text:

    If intent_code equals 3:
        Return "conversion".
    If intent_code equals 2:
        Return "consideration".
    If intent_code equals 1:
        Return "consideration".
    Return "awareness".

## To ChooseKeywordIntentPoints (intent_code: Int) -> Int:

    If intent_code equals 3:
        Return 25.
    If intent_code equals 2:
        Return 21.
    If intent_code equals 1:
        Return 6.
    Return 8.

## To RoundedWeight (value: Int) and (weight: Int) -> Int:

    Return ((value * weight) + 50) divided by 100.

## To ClampKeywordScore (score: Int) -> Int:

    If score is less than 0:
        Return 0.
    If score is greater than 100:
        Return 100.
    Return score.

## To ChooseVolumePoints (search_volume: Int) -> Int:

    If search_volume is greater than 18835:
        Return 10.
    If search_volume is greater than 6682:
        Return 9.
    If search_volume is greater than 2370:
        Return 8.
    If search_volume is greater than 840:
        Return 7.
    If search_volume is greater than 297:
        Return 6.
    If search_volume is greater than 104:
        Return 5.
    If search_volume is greater than 36:
        Return 4.
    If search_volume is greater than 12:
        Return 3.
    If search_volume is greater than 3:
        Return 2.
    If search_volume is greater than 0:
        Return 1.
    Return 0.

## To ChooseAttainabilityPoints (difficulty: Int) -> Int:

    If difficulty is less than 0:
        Return 5.
    If difficulty is greater than 100:
        Return 0.
    Return (((100 - difficulty) * 5) + 50) divided by 100.

## To ChooseValuePoints (cpc_cents: Int) -> Int:

    If cpc_cents is greater than 3288:
        Return 5.
    If cpc_cents is greater than 1448:
        Return 4.
    If cpc_cents is greater than 607:
        Return 3.
    If cpc_cents is greater than 223:
        Return 2.
    If cpc_cents is greater than 47:
        Return 1.
    Return 0.

## To ChooseOpportunityPoints (opportunity_code: Int) and (rank: Int) and (competitor_rankers: Int) and (direct_competitor_rankers: Int) -> Int:

    If opportunity_code equals 1:
        If rank is greater than 3:
            If rank is less than 21:
                Return 5.
        Return 4.
    If opportunity_code equals 2:
        If direct_competitor_rankers is greater than 0:
            Let direct_points be 3 + direct_competitor_rankers.
            If direct_points is greater than 5:
                Return 5.
            Return direct_points.
        Let competitor_points be 1 + ((competitor_rankers + 1) divided by 2).
        If competitor_points is greater than 3:
            Return 3.
        Return competitor_points.
    Return 2.

## To ChooseKeywordPriorityScore (policy_enabled: Int) and (eligible: Text) and (intent_code: Int) and (business_fit_percent: Int) and (revenue_fit_percent: Int) and (search_volume: Int) and (difficulty: Int) and (cpc_cents: Int) and (opportunity_code: Int) and (rank: Int) and (competitor_rankers: Int) and (direct_competitor_rankers: Int) -> Int:

    If policy_enabled equals 0:
        Return 0.
    If eligible equals "false":
        Return 0.
    Let intent_points be ChooseKeywordIntentPoints(intent_code).
    Let business_points be RoundedWeight(business_fit_percent, 30).
    Let revenue_points be RoundedWeight(revenue_fit_percent, 20).
    Let volume_points be ChooseVolumePoints(search_volume).
    Let attainability_points be ChooseAttainabilityPoints(difficulty).
    Let value_points be ChooseValuePoints(cpc_cents).
    Let opportunity_points be ChooseOpportunityPoints(opportunity_code, rank, competitor_rankers, direct_competitor_rankers).
    Let demand_penalty be 0.
    If search_volume is less than 20:
        If intent_code is less than 3:
            Set demand_penalty to 3.
    Let score be intent_points + business_points + revenue_points + volume_points + attainability_points + value_points + opportunity_points - demand_penalty.
    Return ClampKeywordScore(score).

## To ChooseKeywordPriorityTier (policy_enabled: Int) and (eligible: Text) and (relevance_code: Int) and (revenue_fit_percent: Int) -> Int:

    If policy_enabled equals 0:
        Return 0.
    If eligible equals "false":
        Return 0.
    If relevance_code equals 2:
        If revenue_fit_percent is greater than 84:
            Return 1.
        If revenue_fit_percent is greater than 44:
            Return 2.
        Return 3.
    Return 4.

## To ChooseKeywordPolicyCode (policy_enabled: Int) and (search_volume: Int) and (disqualifiers: Int) and (blocklisted: Int) and (relevance_code: Int) and (intent_code: Int) -> Text:

    If policy_enabled equals 0:
        Return "legacy_keyword_policy".
    If search_volume is less than 1:
        Return "reject_no_demand".
    If disqualifiers is greater than 0:
        Return "reject_disqualified".
    If blocklisted is greater than 0:
        Return "reject_blocklisted".
    If relevance_code equals 0:
        Return "reject_no_relevance".
    If relevance_code equals 2:
        If intent_code equals 3:
            Return "eligible_core_conversion".
        If intent_code equals 2:
            Return "eligible_core_consideration".
        Return "eligible_core_awareness".
    If intent_code equals 3:
        Return "eligible_adjacent_conversion".
    If intent_code equals 2:
        Return "eligible_adjacent_consideration".
    Return "eligible_adjacent_awareness".

## To ChooseKeywordEssential (eligible: Text) and (relevance_code: Int) and (revenue_fit_percent: Int) and (intent_code: Int) and (direct_competitor_rankers: Int) -> Text:

    If eligible equals "false":
        Return "false".
    If relevance_code is less than 2:
        Return "false".
    If revenue_fit_percent is less than 65:
        Return "false".
    If direct_competitor_rankers is greater than 0:
        Return "true".
    If intent_code equals 3:
        Return "true".
    Return "false".

## To ChooseKeywordDataQuality (intent_known: Int) -> Text:

    If intent_known equals 0:
        Return "intent_missing".
    Return "complete".

## To ChooseKeywordRuleIds (policy_code: Text) and (keyword_rule: Text) -> Text:

    If policy_code equals "reject_no_demand":
        Return "reject_no_demand".
    If policy_code equals "reject_disqualified":
        Return "reject_disqualified".
    If policy_code equals "reject_blocklisted":
        Return "reject_blocklisted,blocked_noise".
    If policy_code equals "reject_no_relevance":
        Return "reject_no_relevance,no_vocabulary_match".
    If keyword_rule equals "essential_gap":
        Return "essential_gap".
    If keyword_rule equals "site_vocabulary_match":
        Return "site_vocabulary_match".
    If keyword_rule equals "borderline_gap":
        Return "borderline_gap".
    If keyword_rule equals "supporting_evidence":
        Return "supporting_evidence".
    Return policy_code.

## To ChoosePlanCanExport (identity_matches: Int) -> Text:

    If identity_matches is greater than 0:
        Return "true".
    Return "false".

## To ChoosePlanIdentityRule (identity_matches: Int) -> Text:

    If identity_matches is greater than 0:
        Return "confirmed_business_identity".
    Return "blocked_identity_mismatch".

## To ChoosePlanKeywordTargetLow (approved_keywords: Int) and (usable_keywords: Int) -> Int:

    Let usable_floor be usable_keywords.
    If usable_floor is greater than 12:
        Set usable_floor to 12.
    If approved_keywords is greater than usable_floor:
        Return approved_keywords.
    Return usable_floor.

## To ChoosePlanKeywordTargetHigh (target_low: Int) and (usable_keywords: Int) -> Int:

    Let target_ceiling be target_low + 12.
    Let usable_ceiling be usable_keywords.
    If usable_ceiling is greater than target_ceiling:
        Set usable_ceiling to target_ceiling.
    If target_low is greater than usable_ceiling:
        Return target_low.
    Return usable_ceiling.

## To ChoosePlanForecastConfidence (data_quality_flags: Int) -> Text:

    If data_quality_flags is greater than 0:
        Return "limited".
    Return "directional".

## To ChooseEditorialIntentCode (conversion_language: Int) and (commercial_language: Int) and (provider_intent_code: Int) -> Int:

    If conversion_language is greater than 0:
        Return 3.
    If commercial_language is greater than 0:
        Return 2.
    Return provider_intent_code.

## To ChooseEditorialBusinessFit (business_model_code: Int) and (product_query: Int) and (service_query: Int) -> Int:

    If business_model_code equals 1:
        If service_query is greater than 0:
            Return 2.
        If product_query is greater than 0:
            Return 0.
        Return 1.
    If product_query is greater than 0:
        Return 2.
    If service_query is greater than 0:
        Return 0.
    Return 1.

## To ChooseEditorialOfferFit (theme_role_code: Int) and (offer_overlap: Int) -> Int:

    If theme_role_code equals 1:
        Return 0.
    If theme_role_code equals 2:
        Return 4.
    If offer_overlap is greater than 1:
        Return 3.
    If offer_overlap equals 1:
        Return 1.
    Return 0.

## To ChooseEditorialKeywordIndex (week_slot: Int) and (keyword_count: Int) -> Int:

    If keyword_count is less than 1:
        Return 0.
    Let keyword_index be week_slot.
    While keyword_index is greater than keyword_count:
        Set keyword_index to keyword_index - keyword_count.
    If keyword_index is less than 1:
        Return 1.
    Return keyword_index.

## To ChooseEditorialAngleCode (week_slot: Int) -> Int:

    If week_slot is less than 1:
        Return 1.
    If week_slot is greater than 12:
        Return 12.
    Return week_slot.

## To ChooseEditorialBusinessModel (product_evidence: Int) and (service_evidence: Int) -> Int:

    If product_evidence is greater than 0:
        Return 2.
    Return 1.

## To ChooseProgressCurrentNode (foundation: Int) and (content: Int) and (impressions: Int) and (clicks: Int) and (page_two: Int) and (page_one: Int) and (key_events: Int) and (compounding: Int) -> Int:

    If foundation equals 0:
        Return 1.
    If content equals 0:
        Return 2.
    If impressions equals 0:
        Return 3.
    If impressions equals 0:
        Return 4.
    If clicks equals 0:
        Return 5.
    If page_two equals 0:
        Return 6.
    If page_one equals 0:
        Return 7.
    If key_events equals 0:
        Return 8.
    If compounding equals 0:
        Return 9.
    Return 0.

## To ChooseProgressCompounding (page_one: Int) and (clicks: Int) and (key_events: Int) -> Int:

    If page_one equals 0:
        Return 0.
    If clicks is less than 25:
        Return 0.
    If key_events is less than 1:
        Return 0.
    Return 1.

## To ChooseProgressTaskExcluded (task_code: Int) -> Text:

    If task_code equals 1:
        Return "true".
    If task_code equals 5:
        Return "true".
    If task_code equals 7:
        Return "true".
    Return "false".

## To ChooseProgressTaskPhase (task_code: Int) -> Text:

    If task_code equals 8:
        Return "visibility".
    If task_code equals 9:
        Return "visibility".
    If task_code equals 10:
        Return "visibility".
    If task_code equals 11:
        Return "growth".
    If task_code equals 12:
        Return "growth".
    If task_code equals 13:
        Return "growth".
    Return "ready".

## To ChooseProgressTaskState (status_code: Int) and (current_chosen: Int) and (any_in_progress: Int) -> Text:

    If status_code equals 1:
        Return "complete".
    If status_code equals 2:
        Return "future".
    If status_code equals 3:
        Return "current".
    If any_in_progress is greater than 0:
        Return "future".
    If current_chosen equals 0:
        Return "current".
    Return "future".

## To ChooseLlmEffortState (evidence_code: Int) -> Text:

    If evidence_code equals 2:
        Return "complete".
    If evidence_code equals 1:
        Return "in_progress".
    Return "not_started".

## To ChooseLlmOutcomeState (evidence_available: Int) and (mentions: Int) -> Text:

    If evidence_available equals 0:
        Return "not_started".
    If mentions is greater than 0:
        Return "verified".
    Return "monitoring".

## To ChooseLlmNextStep (content_state: Int) and (platform_state: Int) and (authority_state: Int) -> Int:

    If content_state is less than 2:
        Return 1.
    If platform_state is less than 2:
        Return 2.
    If authority_state is less than 2:
        Return 3.
    Return 4.

## To ChoosePercent (complete: Int) and (total: Int) -> Int:

    If total is less than 1:
        Return 0.
    Return ((complete * 100) + (total divided by 2)) divided by total.

## To ChooseSourceState (complete: Int) and (total: Int) -> Text:

    If total is greater than 0:
        If complete equals total:
            Return "complete".
    If complete is greater than 0:
        Return "in_progress".
    Return "not_started".

## To ChooseCoachTaskOrder (task_code: Int) -> Int:

    If task_code equals 3:
        Return 0.
    If task_code equals 2:
        Return 1.
    If task_code equals 4:
        Return 2.
    If task_code equals 8:
        Return 3.
    If task_code equals 9:
        Return 3.
    If task_code equals 10:
        Return 4.
    If task_code equals 11:
        Return 5.
    If task_code equals 12:
        Return 6.
    If task_code equals 13:
        Return 6.
    If task_code equals 14:
        Return 7.
    Return 99.

## To ChooseCoachCategory (task_code: Int) and (category_code: Int) -> Text:

    If task_code equals 3:
        Return "research-strategy".
    If task_code equals 4:
        Return "content-creation".
    If task_code equals 8:
        Return "distribution".
    If task_code equals 9:
        Return "distribution".
    If task_code equals 10:
        Return "distribution".
    If task_code equals 11:
        Return "distribution".
    If task_code equals 12:
        Return "distribution".
    If task_code equals 13:
        Return "distribution".
    If task_code equals 2:
        If category_code equals 2:
            Return "distribution".
    Return "technical-seo".

## To ChooseProgressDataQuality (provider_available: Int) -> Text:

    If provider_available equals 0:
        Return "provider_missing".
    Return "complete".

## To ClampPercent (value: Int) -> Int:

    If value is less than 0:
        Return 0.
    If value is greater than 100:
        Return 100.
    Return value.

## To ChooseOnboardingCurrentStage (step: Int) -> Int:

    If step is less than 1:
        Return 1.
    If step is greater than 3:
        Return 3.
    Return step.

## To ChooseAuditCompletedStages (percent: Int) -> Int:

    If percent is greater than 99:
        Return 6.
    If percent is greater than 79:
        Return 5.
    If percent is greater than 64:
        Return 4.
    If percent is greater than 44:
        Return 3.
    If percent is greater than 29:
        Return 2.
    If percent is greater than 9:
        Return 1.
    Return 0.

## To ChooseAuditCurrentStage (completed: Int) -> Int:

    If completed is greater than 5:
        Return 6.
    Return completed + 1.

## To ChooseTimingDelayed (status_code: Int) and (elapsed_seconds: Int) -> Text:

    If status_code is greater than 0:
        Return "false".
    If elapsed_seconds is greater than 45:
        Return "true".
    Return "false".

## To ChooseTimingSeconds (status_code: Int) and (progress: Int) and (delayed: Text) -> Int:

    If status_code equals 1:
        Return 0.
    If status_code equals 2:
        Return -1.
    If delayed equals "true":
        Return -1.
    Let bounded be progress.
    If bounded is greater than 99:
        Set bounded to 99.
    If bounded is less than 0:
        Set bounded to 0.
    Let blocks be ((6 * (100 - bounded)) + 99) divided by 100.
    Let remaining be blocks * 5.
    If remaining is less than 5:
        Return 5.
    Return remaining.

## To ChooseRequiredStepReady (field_count: Int) and (required_count: Int) and (email_valid: Int) and (url_valid: Int) -> Text:

    If field_count is less than required_count:
        Return "false".
    If email_valid equals 0:
        Return "false".
    If url_valid equals 0:
        Return "false".
    Return "true".

## To ChooseSimpleStepReady (field_count: Int) and (required_count: Int) -> Text:

    If field_count is less than required_count:
        Return "false".
    Return "true".

## To ChooseAuditHealthScore (available: Int) and (score: Int) -> Int:

    If available equals 0:
        Return -1.
    Return ClampPercent(score).

## To ChooseAuditHealthCode (score: Int) -> Int:

    If score is less than 0:
        Return 0.
    If score is greater than 89:
        Return 4.
    If score is greater than 74:
        Return 3.
    If score is greater than 49:
        Return 2.
    Return 1.

## To ChooseAuditPartial (critical: Int) and (warnings: Int) and (visible_issues: Int) -> Text:

    If critical + warnings is greater than visible_issues:
        Return "true".
    Return "false".

## To ChooseRankReadingCode (status_code: Int) and (found_code: Int) and (position: Int) -> Int:

    If status_code equals 2:
        Return 0.
    If status_code equals 0:
        Return 1.
    If found_code is less than 0:
        Return 1.
    If found_code equals 0:
        Return 2.
    If position is less than 1:
        Return 2.
    Return 3.

## To ChooseRankMovementCode (status_code: Int) and (has_previous: Int) and (current_found: Int) and (current_position: Int) and (previous_found: Int) and (previous_position: Int) -> Int:

    If status_code equals 0:
        Return 0.
    If status_code equals 2:
        Return 0.
    If has_previous equals 0:
        If current_found equals 1:
            Return 1.
        Return 0.
    If current_found equals 1:
        If previous_found equals 0:
            Return 2.
    If current_found equals 0:
        If previous_found equals 1:
            Return 3.
    If current_position is less than 1:
        If previous_position is less than 1:
            Return 0.
        Return 3.
    If previous_position is less than 1:
        Return 1.
    If current_position is less than previous_position:
        Return 4.
    If current_position is greater than previous_position:
        Return 5.
    Return 6.

## To ChooseRankMovementDelta (current_position: Int) and (previous_position: Int) -> Int:

    If current_position is less than 1:
        Return 0.
    If previous_position is less than 1:
        Return 0.
    Return previous_position - current_position.

## To ChooseRankFreshnessCode (has_last_check: Int) and (age_hours: Int) and (age_days: Int) -> Int:

    If has_last_check equals 0:
        If age_hours is greater than 24:
            Return 1.
        Return 0.
    If age_days is greater than 6:
        Return 2.
    Return 3.

## To ChooseRankBucket (found: Int) and (position: Int) -> Int:

    If found equals 0:
        Return 0.
    If position is less than 1:
        Return 0.
    If position is less than 4:
        Return 1.
    If position is less than 11:
        Return 2.
    If position is less than 21:
        Return 3.
    Return 4.

## To ChooseArticleWordIssue (format_code: Int) and (word_count: Int) -> Text:

    If format_code equals 1:
        If word_count is less than 1900:
            Return "true".
        If word_count is greater than 3200:
            Return "true".
        Return "false".
    If word_count is less than 700:
        Return "true".
    If word_count is greater than 2600:
        Return "true".
    Return "false".

## To ChooseArticleHeadingIssue (format_code: Int) and (h1_count: Int) and (h2_count: Int) and (h3_count: Int) and (skipped_level: Int) -> Text:

    If h1_count is less than 1:
        Return "true".
    If h1_count is greater than 1:
        Return "true".
    If h3_count is less than 1:
        Return "true".
    If skipped_level equals 1:
        Return "true".
    If format_code equals 1:
        If h2_count is less than 6:
            Return "true".
        If h2_count is greater than 9:
            Return "true".
        Return "false".
    If h2_count is less than 3:
        Return "true".
    Return "false".

## To ChooseArticleBrigadeIssue (format_code: Int) and (brigade_count: Int) -> Text:

    If format_code equals 1:
        If brigade_count is less than 4:
            Return "true".
        If brigade_count is greater than 9:
            Return "true".
        Return "false".
    If brigade_count is less than 1:
        Return "true".
    If brigade_count is greater than 6:
        Return "true".
    Return "false".

## To ChooseArticleSourceIssue (format_code: Int) and (source_count: Int) and (cited_count: Int) -> Text:

    Let required be 1.
    If format_code equals 1:
        Set required to 3.
    If source_count is less than required:
        Return "true".
    If cited_count is less than required:
        Return "true".
    Return "false".

## To ChooseAuthoritativeKeywordVerdict (policy_enabled: Int) and (eligible: Text) and (relevance_code: Int) and (legacy_verdict: Text) -> Text:

    If policy_enabled equals 0:
        Return legacy_verdict.
    If eligible equals "false":
        Return "reject".
    If relevance_code equals 2:
        Return "accept".
    Return "review".

## Main

    Let arguments be args().
    Let audit_complete be parseInt(item 2 of arguments).
    Let critical_issues be parseInt(item 3 of arguments).
    Let warnings be parseInt(item 4 of arguments).
    Let ranking_keywords be parseInt(item 5 of arguments).
    Let new_keywords be parseInt(item 6 of arguments).
    Let lost_keywords be parseInt(item 7 of arguments).
