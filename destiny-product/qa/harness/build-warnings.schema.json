{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destiny.local/schemas/build-warnings-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "warnings"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fingerprint", "owner", "reason", "expiresAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "fingerprint": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" }
        }
      }
    }
  }
}
