{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destiny.local/schemas/harness-evidence-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "classification",
    "decision",
    "redReplay",
    "networkMode",
    "touchedRoutes",
    "productPaths"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "changeId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$" },
    "classification": { "enum": ["MEDIUM", "HIGH"] },
    "decision": {
      "type": ["object", "null"],
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "path": { "type": "string", "pattern": "^destiny-product/DEPLOY_LOG\\.md(?:#[-a-z0-9]+)?$" }
      },
      "additionalProperties": false
    },
    "redReplay": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "redCommit", "command", "failurePattern", "testFiles", "implementationPaths"],
          "properties": {
            "mode": { "const": "required" },
            "redCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "command": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "failurePattern": { "type": "string", "minLength": 3 },
            "testFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "\\.(test|spec)\\.[cm]?[jt]sx?$" } },
            "implementationPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "exemption"],
          "properties": {
            "mode": { "const": "not-applicable" },
            "exemption": { "enum": ["decision-record-only", "docs-only", "protected-revert", "generated-inventory-only"] }
          }
        }
      ]
    },
    "networkMode": { "enum": ["mocked", "local-isolated", "staging-readonly", "authorized-live"] },
    "touchedRoutes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
    "productPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
  }
}
