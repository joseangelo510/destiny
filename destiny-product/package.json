{
  "name": "destiny-product",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "logos:embed": "node scripts/embed-logos-wasm.mjs",
    "port:preflight": "bash scripts/check-replit-port-manifest.sh",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.isolation.config.mjs",
    "qa:migrations": "node scripts/qa-migrations.mjs",
    "qa:inventory": "node scripts/qa-inventory.mjs",
    "qa:isolation": "node scripts/qa-isolation.mjs",
    "qa:browser-fixture": "node scripts/qa-browser-fixture.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod-readonly": "QA_PROD_READONLY=1 playwright test qa/e2e/prod-readonly.spec.ts",
    "test:links": "playwright test qa/e2e/links.spec.ts",
    "gate": "node scripts/qa-gate.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "html-to-docx": "1.8.0",
    "mammoth": "^1.12.1",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
